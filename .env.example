# Voice Note to ClickUp SOP - Environment Variables
# Copy this file to .env and fill in your actual keys

# OpenAI API Key (get from: https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# ClickUp API Key (get from: https://app.clickup.com/settings/apps)
CLICKUP_API_KEY=pk_...

# Default ClickUp List ID (optional - can be passed as argument)
# Find this in your ClickUp URL or via API
CLICKUP_DEFAULT_LIST_ID=123456789
